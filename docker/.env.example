# Copier en .env, chmod 600. Un seul secret ici.
GF_RUNNER_TOKEN=          # token de registration (Settings > Actions > Runners > New self-hosted runner) ou PAT admin:org
GF_RUNNER_URL=https://github.com/Prismo-Studio
GODOT_VERSION=4.5         # doit egaler .godot-version des jeux
GF_ADB_HOST=              # ex. host.docker.internal:5555 pour Waydroid sur l hote
