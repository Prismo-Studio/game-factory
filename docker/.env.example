# Copier en .env, chmod 600. Un seul secret ici.
GF_RUNNER_TOKEN=          # token de registration (expire en 1 h) OU un token fine-grained avec la permission d org « Self-hosted runners : Read and write » (jamais d expiration, echange automatique)
GF_RUNNER_URL=https://github.com/Prismo-Studio
GODOT_VERSION=4.7.2         # doit egaler .godot-version des jeux
GF_ADB_HOST=              # ex. host.docker.internal:5555 pour Waydroid sur l hote
