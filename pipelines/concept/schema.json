{
  "type": "object",
  "required": ["title", "pitch", "loop", "seconds", "fakeAdHook", "assets", "placements", "risk"],
  "properties": {
    "title": { "type": "string", "maxLength": 60 },
    "pitch": { "type": "string", "maxLength": 600 },
    "loop": { "type": "array", "minItems": 3, "maxItems": 7, "items": { "type": "string", "maxLength": 200 } },
    "seconds": { "type": "object", "required": ["0", "10", "60"], "properties": { "0": { "type": "string" }, "10": { "type": "string" }, "60": { "type": "string" } } },
    "fakeAdHook": { "type": "string", "maxLength": 400 },
    "assets": { "type": "array", "minItems": 1, "maxItems": 15, "items": { "type": "string", "maxLength": 120 } },
    "placements": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "maxLength": 160 } },
    "risk": { "type": "string", "maxLength": 400 }
  }
}
